import /init.recovery.qcom_decrypt.rc

on early-init
    start set_permissive

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

on property:init.svc.fastbootd=running
    setprop twrp.modules.loaded true

on post-fs && property:init.svc.fastbootd=stopped
    # Trigger loading kernel modules in normal mode
    setprop twrp.modules.loaded true

on property:twrp.modules.loaded=true
    # Load kernel modules and ADSP firmware for PMIC
    wait /sys/kernel/boot_adsp/boot
    start runatboot
    wait /sys/class/power_supply/battery

on post-fs
    start boot-hal-1-2

on boot
    start health-hal-2-1

service set_permissive /system/bin/set_permissive.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

service runatboot /system/bin/runatboot.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0
    
on post-fs-data
    # Issue flat, non-destructive sysfs commands to clear and re-probe the bus
    write /sys/devices/platform/soc/990000.i2c/i2c-0/delete_device 0x5d
    write /sys/devices/platform/soc/990000.i2c/i2c-0/delete_device 0x49
    write /sys/devices/platform/soc/990000.i2c/i2c-0/new_device "gt9916 0x5d"
    write /sys/devices/platform/soc/990000.i2c/i2c-0/new_device "st_fts 0x49"
    
    # Start the variant-safe watchdog loop
    start mmi_gui_kick

service mmi_gui_kick /system/bin/sh -c "for i in \$(seq 1 60); do ls /dev/input/event* >/dev/null 2>&1 && sleep 1.5 && pkill -f recovery && break; sleep 0.5; done"
    user root
    group root
    seclabel u:r:recovery:s0
    oneshot

